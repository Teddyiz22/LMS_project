NODE_ENV=development
PORT=4001
CLIENT_ORIGIN=http://localhost:5174

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=eduflow
DB_CONNECTION_LIMIT=10

# Authentication. Use a long random secret — at least 32 characters.
# Auth is unavailable until JWT_SECRET is set to a real secret; the value
# below is only a placeholder and is rejected as if it were missing.
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=1h
